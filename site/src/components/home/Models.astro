---
// The launch targets as one list to copy from: each recipe's command, card and the speeds its [receipt]
// states, read from recipes/ (src/release.mjs). A draft recipe comes last, with --allow-draft.
import { recipes } from "../../release.mjs";

const copyIcon = `<svg viewBox="0 0 16 16" aria-hidden="true"><rect x="5" y="5" width="9" height="9" rx="2" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="M3.5 10.5h-.5A1.5 1.5 0 0 1 1.5 9V3A1.5 1.5 0 0 1 3 1.5h6A1.5 1.5 0 0 1 10.5 3v.5" fill="none" stroke="currentColor" stroke-width="1.5"/></svg>`;
// Rounded half up, as the receipts round them (25.45 -> 25.5).
const tps = (v?: number) => (v == null ? "–" : v >= 100 ? String(Math.round(v)) : (Math.round(v * 10 + 1e-9) / 10).toFixed(1));
const rows = recipes.map((r) => {
  const draft = r.status !== "released";
  const cmd = `tensorless run ${r.model.hf_repo}${draft ? " --allow-draft" : ""}`;
  return {
    cmd,
    draft,
    repo: r.model.hf_repo,
    // How many cards, and which. Every recipe runs on one card today (the launcher picks one GPU); a
    // multi-card recipe will name its count in [card] when the launcher can run one.
    card: `1× ${r.card.title.replace(/^NVIDIA /, "")}`,
    decode: tps(r.receipt?.decode_tps?.short),
    prefill: tps(r.receipt?.prefill_tps?.ctx_4k),
    long: tps(r.receipt?.decode_tps?.ctx_32k),
  };
});
const released = rows.filter((r) => !r.draft).length;
const words = ["No", "One", "Two", "Three", "Four", "Five", "Six"];
---

<section class="section" id="models" aria-labelledby="models-title">
  <div class="wrap">
    <p class="label" data-reveal>Launch targets</p>
    <h2 id="models-title" class="h2" data-reveal>{words[released] ?? released} models, one card, one engine.</h2>
    <p class="lede" data-reveal>Copy a command and run it. Each one is a recipe: the image, file and settings that were measured on that card.</p>
    <div class="list" data-reveal>
      <table>
        <thead>
          <tr>
            <th scope="col">Command</th>
            <th scope="col" class="card">Card</th>
            <th scope="col" class="num">Decode</th>
            <th scope="col" class="num">Prefill</th>
            <th scope="col" class="num long">Decode at 32K</th>
          </tr>
        </thead>
        <tbody>
          {
            rows.map((r) => (
              <tr>
                <td>
                  <div class="c">
                    <div class="cmd">
                      <code>{r.cmd}</code>
                      <button class="copy" type="button" data-copy={r.cmd} aria-label={`Copy: ${r.cmd}`} set:html={copyIcon} />
                    </div>
                    {r.draft && <span class="tag">draft</span>}
                  </div>
                </td>
                <td data-label="Card">{r.card}</td>
                <td class="num" data-label="Decode">{r.decode}</td>
                <td class="num" data-label="Prefill">{r.prefill}</td>
                <td class="num" data-label="Decode at 32K">{r.long}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
    <p class="note small" data-reveal>
      Card is how many cards and which. Tokens a second, greedy, from each recipe's receipt: decode after a short prompt (North-Mini-Code-1.0: 4,096
      tokens), prefill on a cold prompt of about 4,000 tokens, decode after a 32K prompt. – is not measured yet. A draft has not
      passed the release gate on its published image. <a href="/docs/reference/launch-targets/">Every target in full</a>
    </p>
  </div>
</section>

<style>
  .list {
    margin-top: 2rem;
    overflow-x: auto;
  }
  table {
    width: 100%;
    table-layout: fixed;
    border-collapse: collapse;
    font-size: 0.86rem;
  }
  th.card {
    width: 10.5rem;
  }
  th.num {
    width: 5rem;
  }
  th.long {
    width: 7.5rem;
  }
  th {
    text-align: left;
    font-weight: 500;
    color: var(--muted);
    padding: 0 0.8rem 0.6rem;
    white-space: nowrap;
  }
  td {
    padding: 0.45rem 0.8rem;
    border-top: 1px solid var(--rule);
    white-space: nowrap;
    vertical-align: middle;
  }
  th:first-child,
  td:first-child {
    padding-left: 0;
  }
  .num {
    text-align: right;
    font-variant-numeric: tabular-nums;
  }
  .c {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    min-width: 0;
  }
  .cmd {
    flex: 1;
    min-width: 0;
    background: var(--panel-2);
  }
  .cmd code {
    padding: 0.45rem 0.7rem;
    font-size: 0.78rem;
  }
  .copy {
    width: 2.2rem;
  }
  .tag {
    font-size: 0.72rem;
    color: var(--muted);
    border: 1px solid var(--rule);
    border-radius: 999px;
    padding: 0.05rem 0.5rem;
  }
  @media (max-width: 720px) {
    thead {
      display: none;
    }
    tr {
      display: flex;
      flex-wrap: wrap;
      gap: 0.3rem 1.2rem;
      padding: 0.7rem 0;
      border-top: 1px solid var(--rule);
    }
    td {
      display: block;
      padding: 0;
      border: 0;
      text-align: left;
    }
    td:first-child {
      flex: 1 0 100%;
      min-width: 0;
      max-width: 100%;
    }
    td[data-label]::before {
      content: attr(data-label) " ";
      color: var(--muted);
    }
  }
  .note {
    margin: 0.9rem 0 0;
    color: var(--muted);
  }
  .note a {
    color: var(--ink-2);
  }
</style>
