---
// The home page's frame: head, header and footer. Dark only, like the docs.

import "@fontsource-variable/geist";
import "@fontsource-variable/geist-mono";
import "../styles/home.css";
import Logo from "../assets/logo.svg?raw";
import { fathom } from "../analytics.mjs";
import { release } from "../release.mjs";

interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const og = new URL("/og.png", Astro.site).href;
const repo = "https://github.com/iammrduncan/tensorless";
const discord = "https://discord.gg/3Qs2uejUf9";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="tensorless" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={og} />
    <script is:inline>
      document.documentElement.classList.add("js");
    </script>
    <script is:inline {...fathom}></script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap bar">
        <a class="brand" href="/" aria-label="tensorless home">
          <span class="logo" set:html={Logo} />
          <span class="word">tensorless</span>
        </a>
        <nav class="nav" aria-label="Main">
          <a href="/docs/">Docs</a>
          <a href={`${repo}/releases`}>Releases</a>
        </nav>
        <div class="actions">
          <a class="icon" href={repo} aria-label="tensorless on GitHub">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.52-1.33-1.28-1.69-1.28-1.69-1.050-.71.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.56-.29-5.25-1.28-5.25-5.690 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.84 1.19 3.1 0 4.42-2.7 5.39-5.26 5.68.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5Z"/></svg>
          </a>
          <a class="icon" href={discord} aria-label="tensorless on Discord">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M20.32 4.37A19.8 19.8 0 0 0 15.43 2.85a.07.07 0 0 0-.08.04c-.21.38-.44.87-.61 1.25a18.3 18.3 0 0 0-5.49 0 12.6 12.6 0 0 0-.62-1.25.08.08 0 0 0-.08-.04 19.7 19.7 0 0 0-4.89 1.52.07.07 0 0 0-.03.03C.53 9.05-.32 13.58.1 18.06a.08.08 0 0 0 .03.06 19.9 19.9 0 0 0 5.99 3.03.08.08 0 0 0 .08-.03c.46-.63.87-1.3 1.23-1.99a.08.08 0 0 0-.04-.11 13.1 13.1 0 0 1-1.87-.89.08.08 0 0 1-.01-.13l.37-.29a.07.07 0 0 1 .08-.01c3.93 1.79 8.18 1.79 12.06 0a.07.07 0 0 1 .08.01l.37.29a.08.08 0 0 1-.01.13c-.6.35-1.22.65-1.87.89a.08.08 0 0 0-.04.11c.36.7.77 1.36 1.23 1.99a.08.08 0 0 0 .08.03 19.8 19.8 0 0 0 6-3.03.08.08 0 0 0 .03-.06c.5-5.18-.84-9.67-3.55-13.66a.06.06 0 0 0-.03-.03ZM8.02 15.33c-1.18 0-2.16-1.09-2.16-2.42 0-1.33.96-2.42 2.16-2.42 1.21 0 2.18 1.1 2.16 2.42 0 1.33-.96 2.42-2.16 2.420Zm7.97 0c-1.18 0-2.16-1.09-2.16-2.42 0-1.33.96-2.42 2.16-2.42 1.21 0 2.18 1.1 2.16 2.42 0 1.33-.95 2.42-2.16 2.42Z"/></svg>
          </a>

        </div>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap foot">
        <p class="small">
          tensorless is open source, under the <a href={`${repo}/blob/main/LICENSE`}>Apache License 2.0</a>. Its engine is a
          fork of <a href="https://github.com/ggml-org/llama.cpp">llama.cpp</a>. v{release.launcher} · {release.engine}.
        </p>
        <nav class="foot-links small" aria-label="Footer">
          <a href="/docs/">Docs</a>
          <a href="/docs/project/credits/">Credits</a>
          <a href={discord}>Discord</a>
          <a href={repo}>GitHub</a>
        </nav>
      </div>
    </footer>
  </body>
</html>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid var(--rule);
    background: rgba(7, 8, 12, 0.78);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
  }
  .bar {
    display: flex;
    align-items: center;
    gap: 1.75rem;
    height: 3.6rem;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    text-decoration: none;
  }
  .logo {
    display: inline-flex;
    flex: none;
  }
  .logo :global(svg) {
    width: 32px;
    height: 32px;
  }
  /* Bitsy sheds a little more when you point at it. */
  .logo :global(.flake) {
    transition: transform 0.35s ease;
  }
  .brand:hover .logo :global(.flake) {
    transform: translate(1.5px, -1.5px);
  }
  .word .less {
    color: var(--muted);
  }
  .word {
    font-weight: 650;
    font-size: 1.02rem;
    letter-spacing: -0.02em;
  }
  .nav {
    display: flex;
    gap: 1.25rem;
  }
  .nav a {
    color: var(--muted);
    text-decoration: none;
    font-size: 0.92rem;
  }
  .nav a:hover {
    color: var(--ink);
  }
  @media (max-width: 480px) {
    .nav a + a {
      display: none;
    }
    .bar {
      gap: 1rem;
    }
  }
  .actions {
    margin-left: auto;
    display: flex;
    gap: 0.15rem;
  }
  .icon {
    display: grid;
    place-items: center;
    width: 2.1rem;
    height: 2.1rem;
    border: 0;
    border-radius: 7px;
    background: transparent;
    color: var(--ink-2);
    cursor: pointer;
  }
  .icon:hover {
    background: var(--panel-2);
  }
  .icon svg {
    width: 18px;
    height: 18px;
  }
  .site-footer {
    border-top: 1px solid var(--rule);
    padding-block: 2rem 2.5rem;
  }
  .foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1rem 2rem;
  }
  .foot p {
    margin: 0;
    max-width: 40rem;
  }
  .foot a {
    color: var(--ink-2);
  }
  .foot-links {
    display: flex;
    gap: 1.25rem;
  }
  .foot-links a {
    text-decoration: none;
  }
  .foot-links a:hover {
    color: var(--ink);
  }
</style>


